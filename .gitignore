# Chimera - Sovereign, local-first (never commit secrets or large traces)

# Rust
/target/
**/*.rs.bk

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node / Go (if used)
node_modules/
vendor/

# Secrets & keys (CRITICAL - forensic safety)
.env
.env.*
!.env.live.example
secrets.env
*.pem
*.key
wallets/
clean_eoa_seeds.txt
private_keys/
.env.live

# Large data / traces (local only)
*.parquet
*.csv
traces/
historical/
revm_cache/
*.db
*.sqlite*

# Docker / monitoring data
docker/data/
monitoring/grafana/data/
prometheus/data/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Foundry
cache/
out/
broadcast/

# Runtime logs (may embed RPC URLs with API keys)
logs/
# Ollama / models (large)
ollama/models/

# Misc
*.log
*.bak

# Project Chimera - state & audit artifacts
core/state/
core/snapshots/
config/snapshot.json
ai-audit/queue/
ai-audit/.daily_counter.json
research/raw/
*.flag


# Python virtual environment
.venv/

# Scratch / temp artifacts
temp_executor.yul

# Scratch commit-message notes (kept locally, never committed)
commit.txt

# Conversation exports / research transcripts (local only, not for release)
chimera-expansion-*.md

# Misplaced duplicate (canonical copy lives at core/tests/fixtures/)
tests/fixtures/golden_replays.json
keystores/
rustup-init.exe

# Timestamped snapshot backups taken before a regeneration (*.bak alone does not
# match the `.bak-<timestamp>` suffix).
config/snapshot.json.bak-*

# Persisted borrower discovery cache: regenerable, grows to hundreds of
# thousands of addresses, and changes on every incremental scan.
config/borrowers.*.json

# Local live launcher — holds operator-specific paths, intentionally untracked.
tmp_run_live.sh
tmp_run_live.sh.orig
