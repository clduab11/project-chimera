{
  "dashboard": {
    "uid": "chimera-overview",
    "title": "Chimera Overview",
    "schemaVersion": 39,
    "refresh": "10s",
    "tags": ["chimera", "mev", "observability"],
    "time": { "from": "now-6h", "to": "now" },
    "timezone": "browser",
    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "query": "prometheus",
          "current": {},
          "hide": 0
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Daily Net USD",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": -50 },
                { "color": "green", "value": 0 }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "colorMode": "value",
          "graphMode": "area",
          "textMode": "auto"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "chimera_daily_net_usd",
            "legendFormat": "daily net"
          }
        ]
      },
      {
        "id": 2,
        "title": "Weekly Net USD",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": -200 },
                { "color": "green", "value": 0 }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "colorMode": "value",
          "graphMode": "area",
          "textMode": "auto"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "chimera_weekly_net_usd",
            "legendFormat": "weekly net"
          }
        ]
      },
      {
        "id": 3,
        "title": "Breaker State",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "max": 1,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 1 }
              ]
            },
            "mappings": [
              { "type": "value", "options": { "0": { "text": "OK", "color": "green" } } },
              { "type": "value", "options": { "1": { "text": "TRIPPED", "color": "red" } } }
            ]
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "auto"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "chimera_breaker_state",
            "legendFormat": "breaker"
          }
        ]
      },
      {
        "id": 4,
        "title": "L1 Data Fee (wei)",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "blue", "value": null }]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "colorMode": "value",
          "graphMode": "area",
          "textMode": "auto"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "chimera_l1_fee_wei",
            "legendFormat": "l1 fee (wei)"
          }
        ]
      },
      {
        "id": 5,
        "title": "Candidate Rate",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
          },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
          "tooltip": { "mode": "multi", "sort": "none" }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "rate(chimera_candidates_seen_total[5m])",
            "legendFormat": "{{chain}}"
          }
        ]
      },
      {
        "id": 6,
        "title": "Gas Used (p95)",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
          },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
          "tooltip": { "mode": "multi", "sort": "none" }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "histogram_quantile(0.95, rate(chimera_gas_used_bucket[5m]))",
            "legendFormat": "gas p95"
          }
        ]
      },
      {
        "id": 7,
        "title": "Simulation Profit USD (p50)",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
          },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
          "tooltip": { "mode": "multi", "sort": "none" }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "histogram_quantile(0.5, rate(chimera_profit_usd_bucket[5m]))",
            "legendFormat": "profit p50"
          }
        ]
      },
      {
        "id": 8,
        "title": "Reverts",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
          },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
          "tooltip": { "mode": "multi", "sort": "none" }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "rate(chimera_revert_total[5m])",
            "legendFormat": "{{reason}}"
          }
        ]
      },
      {
        "id": 9,
        "title": "Simulation Latency (p95)",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
          },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
          "tooltip": { "mode": "multi", "sort": "none" }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "histogram_quantile(0.95, rate(chimera_sim_latency_seconds_bucket[5m]))",
            "legendFormat": "sim latency p95"
          }
        ]
      },
      {
        "id": 10,
        "title": "Simulations Run Rate",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
          },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
          "tooltip": { "mode": "multi", "sort": "none" }
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "rate(chimera_sims_run_total[5m])",
            "legendFormat": "{{result}}"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
