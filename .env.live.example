# Project Chimera — LIVE environment template (EXAMPLE — placeholders only)
#
# Copy OUTSIDE the repo (e.g. ~/chimera.env) or keep as .env.live in the repo
# root (gitignored via `.env.*`; only this .example file is committable).
# NEVER commit real values. NEVER paste API keys into chat, logs, or git.
# chmod 600 the real file. Rotate any key that was ever pasted into a log.
#
# Load (WSL):  set -a; source ~/chimera.env; set +a

# --- RPC (pick ONE provider to conserve credits; HTTPS for reads/tx, WSS for blocks) ---
# This file is safely SOURCEABLE as-is: all values are quoted strings.
# Fill real values between the quotes; leave "" for anything not yet known.
BASE_RPC_URL=""                          # e.g. https://base-mainnet.g.alchemy.com/v2/<key> or Infura HTTPS
CHIMERA_WS_ENDPOINT=""                   # e.g. wss://base-mainnet.g.alchemy.com/v2/<key> or Infura WSS

# --- Custody (keystores live OUTSIDE the repo; addresses are public, keys never) ---
CHIMERA_EXECUTOR_ADDRESS=""              # 0x… after the §B.3 deploy
CHIMERA_TREASURY_ADDRESS=""              # 0x… printed by `--role treasury` provisioning
CHIMERA_TREASURY_KEYSTORE="$HOME/.chimera/keystores/treasury.json"
CHIMERA_WORKER_KEYSTORE_DIR="$HOME/.chimera/keystores/workers"
CHIMERA_EOA_POOL_PATH=config/eoa_pool.json

# --- Secrets (environment only; never in git, never echoed) ---
CHIMERA_KEYSTORE_PASSWORD=""             # set-by-operator; required before provisioning
CHIMERA_OPERATOR_TOKEN=""                # gates clear_breaker only

# --- Mode (the ONLY live flip; committed config/pacing.yaml stays shadow) ---
CHIMERA_EXECUTE_MODE=shadow                # set to `live` only at go-live

# --- Optional overrides (defaults are already correct for Base mainnet) ---
# CHIMERA_CHAIN_ID=8453
# CHIMERA_SNAPSHOT_PATH=config/snapshot.json
# CHIMERA_METRICS_PORT=9100                # actual port = 9100 + (chain_id % 1000) = 9553 on Base
# CHIMERA_ETH_USD_FEED_ADDRESS=0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70
# CHIMERA_AAVE_POOL=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
# CHIMERA_EMERGENCY_FLAG=core/state/emergency.flag
# RUST_LOG=chimera=info
